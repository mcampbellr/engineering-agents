{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "diff",
            "system",
            "design"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "commit",
        "dirty",
        "mode",
        "description"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "description": "Unknowns are recorded as null, never omitted and never faked.",
      "properties": {
        "stack": {
          "type": [
            "string",
            "null"
          ]
        },
        "versions": {
          "type": [
            "object",
            "null"
          ]
        },
        "workload": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commands": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "warmup": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "repetitions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "artifacts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "stack",
        "versions",
        "workload",
        "dataset",
        "seed",
        "hardware",
        "limits",
        "instruments",
        "commands",
        "date",
        "warmup",
        "duration",
        "repetitions",
        "artifacts"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "requires_changes",
        "inconclusive",
        "no_blocking_findings"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_state": {
            "type": "string",
            "enum": [
              "measured",
              "static",
              "hypothesis",
              "not_tested"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "path",
                "line"
              ],
              "additionalProperties": false
            }
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "existing_mitigations": {
            "type": "string",
            "minLength": 1
          },
          "counterevidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "properties": {
              "procedure": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "string",
                "minLength": 1
              },
              "executed": {
                "type": "boolean"
              },
              "artifact": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "procedure",
              "acceptance",
              "executed",
              "artifact"
            ],
            "additionalProperties": false
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "pending_decision",
              "follow_up"
            ],
            "default": "open"
          }
        },
        "required": [
          "id",
          "title",
          "area",
          "severity",
          "confidence",
          "evidence_state",
          "locations",
          "mechanism",
          "trigger",
          "impact",
          "existing_mitigations",
          "counterevidence",
          "recommendation",
          "tradeoffs",
          "validation",
          "source_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_state": {
                  "const": "measured"
                }
              }
            },
            "then": {
              "properties": {
                "validation": {
                  "properties": {
                    "executed": {
                      "const": true
                    },
                    "artifact": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "title": "executed=true requires an accessible artifact",
            "if": {
              "properties": {
                "validation": {
                  "properties": {
                    "executed": {
                      "const": true
                    }
                  },
                  "required": [
                    "executed"
                  ]
                }
              },
              "required": [
                "validation"
              ]
            },
            "then": {
              "properties": {
                "validation": {
                  "properties": {
                    "artifact": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "title": "executed=false is a proposal, so it carries no artifact",
            "if": {
              "properties": {
                "validation": {
                  "properties": {
                    "executed": {
                      "const": false
                    }
                  },
                  "required": [
                    "executed"
                  ]
                }
              },
              "required": [
                "validation"
              ]
            },
            "then": {
              "properties": {
                "validation": {
                  "properties": {
                    "artifact": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          {
            "title": "measured or static findings must carry at least one location",
            "if": {
              "properties": {
                "evidence_state": {
                  "enum": [
                    "measured",
                    "static"
                  ]
                }
              },
              "required": [
                "evidence_state"
              ]
            },
            "then": {
              "properties": {
                "locations": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_tested",
              "not_applicable"
            ]
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "criterion",
          "evidence",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          },
          "sample_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "name",
          "unit",
          "value",
          "baseline",
          "target",
          "target_origin",
          "method",
          "artifact",
          "sample_size"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            },
            "then": {
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_size": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "title": "an unexecuted metric has no artifact and no sample size",
            "if": {
              "properties": {
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "value"
              ]
            },
            "then": {
              "properties": {
                "artifact": {
                  "type": "null"
                },
                "sample_size": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_on": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "version",
          "accessed_on"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain": {
      "type": "object",
      "description": "Domain-specific rubrics and detail; not production measurements or a cross-skill score."
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "skill",
    "run_id",
    "scope",
    "environment",
    "verdict",
    "findings",
    "controls",
    "metrics",
    "sources",
    "limitations",
    "next_steps"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "title": "requires_changes needs at least one confirmed finding; hypotheses alone do not justify it",
      "if": {
        "properties": {
          "verdict": {
            "const": "requires_changes"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "evidence_state": {
                  "enum": [
                    "measured",
                    "static"
                  ]
                },
                "severity": {
                  "enum": [
                    "critical",
                    "high",
                    "medium"
                  ]
                },
                "status": {
                  "not": {
                    "const": "fixed"
                  }
                }
              },
              "required": [
                "evidence_state",
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "title": "no_blocking_findings cannot coexist with a confirmed critical or high finding",
      "if": {
        "properties": {
          "verdict": {
            "const": "no_blocking_findings"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "not": {
                "properties": {
                  "evidence_state": {
                    "enum": [
                      "measured",
                      "static"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "critical",
                      "high"
                    ]
                  },
                  "status": {
                    "not": {
                      "const": "fixed"
                    }
                  }
                },
                "required": [
                  "evidence_state",
                  "severity"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-agents:report:1.0",
  "title": "Engineering audit report"
}
